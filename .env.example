#
# APPLICATION
#
NODE_ENV=production
PORT=5000
ALLOWED_HOSTS=*
STOREFRONT_URL=https://silver14nail.com
ENABLE_SWAGGER=true
SECRET_KEY=your-secret-key-change-this-in-production
TOKEN_EXPIRES=86400
REFRESH_TOKEN_EXPIRES=604800

# CRITICAL: signs every JWT (customer + admin auth). If unset, the app
# silently falls back to a hardcoded default ('local-development-jwt-secret')
# that's visible in the source — anyone could forge valid tokens for any
# account. MUST be set to a long random value in production.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-value

# Restricts which origins the API accepts CORS requests from. If unset,
# defaults to allowing ALL origins — fine for local dev, too permissive for
# production. Comma-separated, no spaces.
CORS_ORIGIN=https://silver14nail.com,https://www.silver14nail.com,https://admin.silver14nail.com

# Optional — order confirmation / password reset emails are silently skipped
# (logged only) if this isn't set.
RESEND_API_KEY=your_resend_api_key


#
# DATABASE
#
# AWS RDS endpoint (Connectivity & security tab on the RDS instance).
DATABASE_HOST=silver14-db.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DATABASE_TYPE=mysql
MYSQL_DATABASE=silver14_nail_db
MYSQL_USER=admin
MYSQL_PASSWORD=change-this-to-the-rds-master-password
# Required by configuration.ts's Joi schema even though the app never
# actually connects with root — same RDS master password as MYSQL_PASSWORD
# above when using the master user directly. Startup fails with
# "mysqlRootPassword is required" if this is missing.
MYSQL_ROOT_PASSWORD=change-this-to-the-rds-master-password


# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

#R2 CLOUD
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=silver14-nail
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# OnePAY
ONEPAY_ENV=sandbox
ONEPAY_MERCHANT_ID=TESTONEPAY
ONEPAY_ACCESS_CODE=your_access_code
ONEPAY_HASH_KEY=your_hash_key
ONEPAY_USER=your_user
ONEPAY_PASSWORD=your_password
ONEPAY_TITLE=Silver14 Nail — Thanh toán OnePAY
ONEPAY_API_URL=https://api.silver14nail.com/api

#
# CROSS-SERVICE (admin/storefront, consumed via docker-compose.yml's
# args:/environment: — see its comments for which is build-time vs runtime)
#
API_URL=http://api:3000
STOREFRONT_INTERNAL_URL=http://storefront:4200
NEXT_PUBLIC_STOREFRONT_URL=https://silver14nail.com
NEXT_PUBLIC_API_URL=https://silver14nail.com/api
# Must match exactly between apps/storefront and apps/admin — protects the
# on-demand ISR revalidation endpoint.
REVALIDATE_SECRET=change-this-to-a-random-value
