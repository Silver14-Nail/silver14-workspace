{
  "name": "@source/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "typeorm": "ts-node --project tsconfig.orm.json -r tsconfig-paths/register --transpile-only ./node_modules/typeorm/cli.js",
    "db:generate": "pnpm run typeorm migration:generate ./src/db/migrations/add-payments-table -d ./src/db/ormconfig.ts",
    "db:migrate": "pnpm run typeorm migration:run -d ./src/db/ormconfig.ts",
    "db:revert": "pnpm run typeorm migration:revert -d ./src/db/ormconfig.ts",
    "db:drop": "pnpm run typeorm schema:drop -d ./src/db/ormconfig.ts",
    "db:seed": "ts-node --project tsconfig.orm.json -r tsconfig-paths/register --transpile-only ./src/db/seed.ts",
    "db:truncate": "ts-node --project tsconfig.orm.json -r tsconfig-paths/register --transpile-only ./src/db/truncate.ts"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "args": [
            "--node-env=production"
          ],
          "cwd": "apps/api"
        },
        "configurations": {
          "development": {
            "args": [
              "--node-env=development"
            ]
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/api/dist/package.json",
          "{workspaceRoot}/apps/api/dist/pnpm-lock.yaml"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/api/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@source/api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@source/api:build:development"
          },
          "production": {
            "buildTarget": "@source/api:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      }
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1049.0",
    "@aws-sdk/s3-request-presigner": "^3.1049.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/mapped-types": "1.2.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/typeorm": "^11.0.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.22.3",
    "nest-router": "^1.0.9",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "stripe": "^22.1.1",
    "tslib": "^2.3.0",
    "typeorm": "^0.3.29"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/cookie-parser": "^1.4.10",
    "tsconfig-paths": "^4.2.0"
  },
  "pnpm": {
    "overrides": {
      "@nestjs/mapped-types": "1.2.0"
    }
  }
}
